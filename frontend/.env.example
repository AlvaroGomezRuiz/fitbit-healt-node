# Plantilla Next.js (`frontend`): copia a `.env.local` (Vercel: Project Settings → Env).

# --- Sitio (login / magic link) ---
NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# --- Supabase (host debe ser `<ref>.supabase.co`, ver Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_min_twenty_chars
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Crons Vercel (`CRON_SECRET` + Bearer; flags truthy: 1/true/yes/on) ---
CRON_SECRET=your_cron_secret
CRON_PRE_ENTRENO_DEEPSEEK=0
# Opcional: ventana civil Madrid HH:MM-HH:MM (fin exclusivo). Por defecto 08:55-09:15.
# CRON_PRE_ENTRENO_WINDOW=08:55-09:15
CRON_RESUMEN_NOCHE_DEEPSEEK=0
CRON_DAILY_NUTRITION_DEEPSEEK=0
# Lista compra + menú semanal (domingo ~10:00 Madrid; doble UTC + ventana civil, ver docs §7)
CRON_NUTRITION_SHOPPING_DEEPSEEK=0
# Opcional: ventana civil Madrid HH:MM-HH:MM (fin exclusivo). Por defecto 09:55-10:15.
# CRON_NUTRITION_SHOPPING_WINDOW=09:55-10:15

# Informe semanal HTML → `reporte_semanal` (domingo ~22:00 Madrid; doble UTC + ventana; `service_role`)
# CRON_INFORME_SEMANAL_WINDOW=21:50-22:25
# CRON_INFORME_SEMANAL_BYPASS_WINDOW=1

# Purga retención Postgres (`retention_run_purge`; lunes ~05:15 Madrid invierno vía UTC)
# CRON_RETENTION_PURGE_DAYS=120

# --- DeepSeek (Server Actions, API cron, `lib/ai`) ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL_CASCADE=deepseek-v4-pro,deepseek-v4-flash
DEEPSEEK_MODEL_COMPLEX=deepseek-v4-pro
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_BACKOFF_BASE_MS=1000
DEEPSEEK_BACKOFF_MAX_MS=16000
DEEPSEEK_TIMEOUT_MS=180000

# --- Fitbit / telemetría (`parseFitbitFeatureFlagsFromEnv`; maestro true|1) ---
FITBIT_ACTIVO=0
NEXT_PUBLIC_FITBIT_UI_ENABLED=0
FITBIT_INGEST_ENABLED=0
FITBIT_SYNC_ENABLED=0

# --- Webhook Google Health (`POST /api/health/google`) ---
HEALTH_WEBHOOK_SECRET=your_health_webhook_secret
