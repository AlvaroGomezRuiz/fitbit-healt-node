{
  "extends": "./frontend/tsconfig.json",
  "compilerOptions": {
    "plugins": [],
    "baseUrl": "./frontend",
    "paths": {
      "@/*": ["./*"],
      "@repo/ai": ["./lib/deepseek-package/index.ts"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "frontend/next-env.d.ts",
    "frontend/.next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "frontend/node_modules", "frontend/.next"]
}
