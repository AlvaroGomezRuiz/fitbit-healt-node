# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Plantilla pública (segura para Git)
# Copia a `.env` y rellena CON TUS valores reales.
# `.env` está en .gitignore y NUNCA debe subirse al repo.
# En producción (Cloud Run) los secretos viven en Google Secret Manager;
# este fichero solo sirve para desarrollo local y bootstrap.
# ─────────────────────────────────────────────────────────────────────────────

# ── GOOGLE OAUTH ────────────────────────────────────────────────────────────
# JSON inline del token (lo genera `python -m scripts.oauth_setup`).
# Local: pega el contenido de token.json en UNA SOLA LINEA.
# Cloud Run: NO se pone aquí — se monta desde Secret Manager `google-oauth-token`.
GOOGLE_OAUTH_TOKEN_JSON=

# ── DEEPSEEK LLM ────────────────────────────────────────────────────────────
# Saca la key en https://platform.deepseek.com → API Keys → Create new
# Pricing oficial: https://api-docs.deepseek.com/quick_start/pricing
DEEPSEEK_API_KEY=sk-...

# Modelos por defecto. Si Pro 429/5xx, cae a Flash automáticamente.
# Pro: razonamiento clínico (HRV, déficit, periodización) — $0.435/1M in (-75% hasta 31 may 2026)
# Flash: extracción rápida + fallback — $0.14/1M in
DEEPSEEK_MODEL_COMPLEX=deepseek-v4-pro
DEEPSEEK_MODEL_SIMPLE=deepseek-v4-flash

# ── GOOGLE DRIVE ────────────────────────────────────────────────────────────
# ID de la carpeta raíz "SALUD" en tu Drive (parte de la URL).
FOLDER_SALUD_ID=

# ID del fichero BIOMETRIA_MAESTRO.json (lo crea `python -m scripts.crear_maestro_drive`).
FILE_ID_MAESTRO=

# ── IDENTIDAD DEL ATLETA ────────────────────────────────────────────────────
FECHA_NACIMIENTO=2007-03-05
PESO_KG_INICIAL=82
ALTURA_CM=160
BODY_FAT_INICIAL_PCT=

# ── ZONA HORARIA ────────────────────────────────────────────────────────────
TZ=Europe/Madrid

# ── ADMIN ────────────────────────────────────────────────────────────────────
# Token aleatorio para proteger el endpoint /admin/seed. Generalo con `uuidgen`.
ADMIN_TOKEN=cambia-esto-por-un-uuid-aleatorio
