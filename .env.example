# Plantilla raíz: copia a `.env` y reemplaza placeholders (nunca subas `.env`).

# --- FastAPI / Docker (`src/health_node.py`) ---
PORT=8080
ADMIN_TOKEN=your_admin_token

# --- Google Drive / OAuth (`src/auth.py`, `src/engines/drive_engine.py`, scripts) ---
# JSON de token OAuth (ver README); alternativa: `token.json` en disco según script.
GOOGLE_OAUTH_TOKEN_JSON=your_google_oauth_token_json
FOLDER_SALUD_ID=your_google_drive_folder_id
FILE_ID_MAESTRO=your_google_drive_maestro_file_id

# --- Supabase (p. ej. `scripts/migrate_from_drive.ts`) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- DeepSeek (Python `src/engines/brain_engine.py`, scripts, `lib/ai` en raíz) ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL_CASCADE=deepseek-v4-pro,deepseek-v4-flash
DEEPSEEK_MODEL_COMPLEX=deepseek-v4-pro
DEEPSEEK_MODEL_SIMPLE=deepseek-v4-flash
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_BACKOFF_BASE_MS=1000
DEEPSEEK_BACKOFF_MAX_MS=16000
DEEPSEEK_TIMEOUT_MS=180000

# --- Fitbit / ingest Python (`src/engines/health_engine.py`) ---
FITBIT_ACTIVO=false

# --- Opcional: biometría inicial (`scripts/crear_maestro_drive.py`) ---
FECHA_NACIMIENTO=2000-01-01
ALTURA_CM=175
PESO_KG_INICIAL=75
BODY_FAT_INICIAL_PCT=20
